<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UbicacionApp.MainPage">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <!-- Botón para activar y guardar la ubicación -->
        <Button Text="Activar Ubicación" 
                Clicked="OnActivarUbicacionClicked" 
                BackgroundColor="#005eb8" 
                TextColor="White"
                FontSize="18"
                HeightRequest="55" />

        <!-- Tabla en la parte inferior usando Grid -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" 
              ColumnSpacing="10" RowSpacing="10" 
              Margin="0,50,0,0">

            <!-- Encabezados de la tabla -->
            <Label Text="Latitud" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="0" />
            <Label Text="Longitud" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="1" />

            <!-- Celdas donde se mostrarán los datos obtenidos -->
            <Label x:Name="lblLatitud" Text="---" HorizontalOptions="Center" Grid.Row="1" Grid.Column="0" />
            <Label x:Name="lblLongitud" Text="---" HorizontalOptions="Center" Grid.Row="1" Grid.Column="1" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>
